{
  "name": "@vakao-ui/scripts-utils",
  "version": "0.0.3",
  "description": "Vakao-UI 脚本工具库（颜色、图标、横幅、日志、工具函数）",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm test && pnpm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "node scripts/demo.mjs",
    "predemo": "pnpm run build"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "keywords": [
    "vakao-ui",
    "scripts",
    "utils",
    "colors",
    "icons",
    "banner",
    "logger"
  ],
  "author": "Vakao UI Team",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vakao-ui/scripts-utils.git"
  },
  "homepage": "https://github.com/vakao-ui/scripts-utils#readme",
  "bugs": {
    "url": "https://github.com/vakao-ui/scripts-utils/issues"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.11.30",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.1.0"
  }
}
